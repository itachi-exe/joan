# Public configuration only. Never add server keys or session secrets here.
# Reachable API does not mean live adapters. Server provenance stays visible.
# Defaults to the loopback persisted agent; offline shows labelled sample stories.
VITE_JOAN_API_URL=http://127.0.0.1:4310

# Optional fallback wire feed. Online reports come from the research API.
VITE_JOAN_WIRE_URL=

# Genuine transaction explorer template; mock_ receipts are never linked.
VITE_EXPLORER_TX_URL=

# Only 1 if the optional public/audio/joan-intro.mp3 has been supplied.
VITE_JOAN_INTRO_AUDIO=

# Server-only variables live in ../agent/.env.example, never in VITE_ variables.
# TAVILY_API_KEY, OPENAI_API_KEY, OPENAI_MODEL, CELO_BUY_API_URL, ALTANA_SESSION_KEY
# Signing/payment remain locked even if configured; see ../PAYMENT-PROOF.md.
