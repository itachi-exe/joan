# No keys are required. Blank values select deterministic mock adapters.
PORT=4310
JOAN_DB_PATH=state/joan.sqlite
JOAN_CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174,http://localhost:5173,http://127.0.0.1:5173
# Public service only, behind nginx overwriting X-Real-IP. Never expose Node directly.
JOAN_PUBLIC_LIMITS=0
JOAN_DAILY_COMMISSION_CAP=60
JOAN_DAILY_LLM_CAP=60
# public enables bounded keyless retrieval; unset keeps the default adapter selection.
JOAN_RESEARCH_PROVIDER=
# Compatible model credential is server-only, never a VITE_ variable.
JOAN_LLM_API_KEY=
JOAN_LLM_BASE_URL=
JOAN_LLM_MODEL=

# Public research: obtain from https://app.tavily.com/
TAVILY_API_KEY=
# One LLM provider: obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Read PAYMENT-PROOF.md. Presence selects live mode, but signing remains disabled.
# Never put an actual session/private key into a tracked file.
ALTANA_SESSION_KEY=
ALTANA_WALLET_ADDRESS=
ALTANA_RPC_URL=
CELO_BUY_API_URL=
# Future settlement wiring only, not consumed by this local buyer.
X402_FACILITATOR_URL=
X402_FACILITATOR_API_KEY=

# Owner-gated proof package only: ../proof/README.md and KEYS-NEEDED.md.
# Keep unset for offline tests. No values belong in this tracked template.
# Explicit owner approval; enables signing/broadcast gates, not consent by itself.
JOAN_ALLOW_MAINNET=
# Owner-created throwaway wallet, small balance, owner go-ahead. Never a primary key.
JOAN_ADMIN_PRIVATE_KEY=
# Owner-selected USDC atomic budget within proof hard ceilings.
JOAN_CAP_USDC_ATOMIC=
# Owner-selected short duration within proof hard ceilings.
JOAN_EXPIRY_SECONDS=
# Program-assigned Celo attribution code from hackathon/Altana registration.
JOAN_APP_CODES=
# Owner-selected private, git-ignored local directory for secret session state.
JOAN_STATE_DIR=
# Owner-verified recipient address for the approved tagged-payment demonstration.
JOAN_TAGGED_PAYEE=
